# Copia este archivo como ".env" y completa los valores. No subas ".env" a Git ni lo compartas.

# --- Correo (SMTP, por ejemplo Gmail con contraseña de aplicación) ---
MI_PACIENTE_SMTP_HOST=smtp.gmail.com
MI_PACIENTE_SMTP_PORT=587
MI_PACIENTE_SMTP_USER=tu_correo@gmail.com
MI_PACIENTE_SMTP_PASSWORD=contraseña_de_aplicacion
MI_PACIENTE_SMTP_FROM=tu_correo@gmail.com

# --- Twilio (SMS y WhatsApp) ---
MI_PACIENTE_TWILIO_ACCOUNT_SID=AC...
MI_PACIENTE_TWILIO_AUTH_TOKEN=...
# Número de Twilio con capacidad de SMS, en formato internacional (+1...)
MI_PACIENTE_TWILIO_SMS_FROM=+1XXXXXXXXXX
# Remitente de WhatsApp (sandbox de Twilio: whatsapp:+14155238886)
MI_PACIENTE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Opcionales ---
# Código de país para números sin "+" (por defecto 57 = Colombia)
MI_PACIENTE_COUNTRY_CODE=57
# Enlace que aparece en los correos
MI_PACIENTE_PUBLIC_URL=http://127.0.0.1:8000/
# MI_PACIENTE_HOST=127.0.0.1
# MI_PACIENTE_PORT=8000
# MI_PACIENTE_DB=ruta\a\otra\base.sqlite3
# MI_PACIENTE_HTTPS=1
